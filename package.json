{
  "name": "typedsh-blog",
  "version": "1.0.2",
  "main": "index.js",
  "author": "Seia-Soto <seia@outlook.kr>",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build && yarn static",
    "serve": "serve out",
    "lint": "eslint --ext .js",
    "update": "yarn update:upstream && yarn update:submodules",
    "update:prepare": "git add remote upstream https://github.com/typed-sh/blog.git",
    "update:upstream": "git stash && git pull upstream master && git stash apply && git stash drop",
    "update:submodules": "git submodule init && git submodule update --remote --merge",
    "release": "standard-version",
    "release:first": "standard-version --first-release",
    "release:pre": "standard-version --prerelease",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "static": "yarn sitemap && yarn mkstatic && yarn packstatic",
    "sitemap": "yarn node scripts/sitemap",
    "mkstatic": "yarn node scripts/mkstatic",
    "packstatic": "yarn node scripts/packstatic"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/runtime": "^1.6.22",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "esm": "^3.2.25",
    "framer-motion": "^12.9.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "js-yaml-loader": "^1.2.2",
    "mime-types": "^3.0.1",
    "next": "^15.3.1",
    "next-compose-plugins": "^2.2.1",
    "next-images": "^1.8.5",
    "next-seo": "^6.6.0",
    "prism-react-renderer": "^2.4.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-ga": "^3.3.1",
    "react-icons": "^5.5.0",
    "sitemap": "^8.0.0"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "^7.20.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-config-standard-jsx": "^10.0.0",
    "eslint-config-standard-react": "^11.0.1",
    "eslint-import-resolver-node": "^0.3.4",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-promise": "^4.3.1",
    "eslint-plugin-react": "^7.22.0",
    "serve": "^14.2.4",
    "standard-version": "^9.5.0"
  }
}